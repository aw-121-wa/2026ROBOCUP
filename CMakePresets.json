{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release-LTO",
            "inherits": "Release",
            "cacheVariables": {
                "CHASSIS_RELEASE_LTO": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CHASSIS_RELEASE_LTO": "OFF"
            }
        },
        {
            "name": "Full-Vision",
            "inherits": "Release-LTO",
            "cacheVariables": {
                "PATH_WAREHOUSE_CAPTURE_START": "OFF",
                "PATH_WAREHOUSE_ONLY_VISION": "OFF",
                "CMAKE_C_FLAGS": "-fno-inline-functions-called-once -flto-partition=one"
            }
        },
        {
            "name": "Warehouse-Capture",
            "inherits": "Release-LTO",
            "cacheVariables": {
                "PATH_WAREHOUSE_CAPTURE_START": "ON",
                "PATH_WAREHOUSE_ONLY_VISION": "OFF",
                "CMAKE_C_FLAGS": "-fno-inline-functions-called-once -flto-partition=one"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Release-LTO",
            "configurePreset": "Release-LTO"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Full-Vision",
            "configurePreset": "Full-Vision"
        },
        {
            "name": "Warehouse-Capture",
            "configurePreset": "Warehouse-Capture"
        }
    ]
}
